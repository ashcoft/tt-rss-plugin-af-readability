{
    "name": "ashcoft/tt-rss-plugin-af-readability",
    "description": "Tiny Tiny RSS plugin for extracting full article content using Readability.php",
    "type": "project",
    "version": "4.1.0",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://packagist.org",
            "canonical": true
        }
    ],
    "require": {
        "php": ">=8.1",
        "fivefilters/readability.php": "^4.1",
        "psr/http-factory": "^1.0"
    },
    "require-dev": {},
    "scripts": {
        "check": "composer validate && phpstan analyse --no-progress",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "ttrss-plugin": {
            "plugin-class": "Af_Readability",
            "plugin-name": "af_readability"
        }
    }
}
